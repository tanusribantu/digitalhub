# ==============================================================================
# DigitalHub Environment Configuration Template
# Copy this file to .env or set environment variables in your deployment environment.
# DO NOT commit real secrets or production passwords to version control.
# ==============================================================================

# Server Port
PORT=8080

# Database Configuration (for MySQL profile: --spring.profiles.active=mysql)
DB_URL=jdbc:mysql://localhost:3306/digitalhub_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Secret (HS256 requires minimum 256 bits / 64 hex characters)
JWT_SECRET=your_custom_jwt_secret_hex_string_min_64_characters_here
JWT_EXPIRATION=86400000